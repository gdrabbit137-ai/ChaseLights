        },
        "sources": [
          {
            "url": "...",
            "kind": "...",
            "note_i18n": "..."
          }
        ]
      }
    },
    "fail_closed": "No current_season entry may exist without source_url+retrieved_at. Display without current_season = climatological typical window only, labeled 'typical'."
