  "topic_definitions": {
    "topic:sunrise": {
      "zh-TW": "已研究的日出攝影，不代表能見度已獲證實。",
      "ja": "研究された日の出撮影。視認できることの証明ではない。"
    },
    "topic:sunset": {
      "zh-TW": "夕照光線或構圖；不得自動推定彩霞。",
      "ja": "夕景の光や構図。彩色の雲を自動的に推定しない。"
    },
    "topic:colorful-clouds": {
      "zh-TW": "已研究的受光彩色雲層；不等於任何日落，也不保證天候。",
      "ja": "研究された、光を受けた色のある雲。すべての日没を意味せず、天候も保証しない。"
    },
    "topic:reflection": {
      "zh-TW": "有證據支持的倒影構圖；幾何限制仍獨立處理。",
      "ja": "証拠のある映り込みの構図。幾何の制約は引き続き独立して扱う。"
    },
    "topic:mountain-landscape": {
      "zh-TW": "有證據支持的山景；不推定雲海、積雪或可進入性。",
      "ja": "証拠のある山の風景。雲海、積雪、立ち入り可能性を推定しない。"
    },
    "topic:coastal-landscape": {
      "zh-TW": "有證據支持的海岸景觀；不推定浪況、潮汐或天候題材。",
      "ja": "証拠のある海岸風景。波、潮汐、天候の撮影機会を推定しない。"
    },
    "topic:flowers": {
      "zh-TW": "有證據支持的花卉題材；不推定開花狀態或季節。",
      "ja": "証拠のある花の被写体。開花状態や季節を推定しない。"
    },
    "topic:cityscape": {
      "zh-TW": "有證據支持的城市景觀；不推定亮燈時程。",
      "ja": "証拠のある都市風景。点灯時刻を推定しない。"
    }
  },
