{
  "version": "0.4",
  "note": "Metric vocabulary for genre condition templates. Condition metrics are unit-normalized ids; bindings map a metric to dataset fields (field naming follows DATA_SOURCE_TIERING_SPEC manifest style: name + unit suffix). '+' joins the fields a derived metric consumes.",
  "metrics": {
    "relative_humidity_925hpa": {
      "unit": "%",
      "domain": "WEATHER",
      "bindings": [
        {
          "dataset": "cwa_wrf3",
          "field": "relative_humidity_925hpa_percent",
          "level": "925hpa",
          "role": "SHORT_HQ"
        }
      ]
    },
    "relative_humidity_850hpa": {
      "unit": "%",
      "domain": "WEATHER",
      "bindings": [
        {
          "dataset": "cwa_wrf3",
          "field": "relative_humidity_850hpa_percent",
          "level": "850hpa",
          "role": "SHORT_HQ"
        }
      ]
    },
    "lcl_height_m_agl": {
      "unit": "m",
      "domain": "WEATHER",
      "bindings": [
        {
          "dataset": "cwa_wrf3",
          "field": "lcl_height_m_agl",
          "role": "SHORT_HQ"
        }
      ]
    },
    "cloud_cover_low": {
      "unit": "%",
      "domain": "WEATHER",
      "bindings": [
        {
          "dataset": "gfs_0p25",
          "field": "cloud_cover_low_percent",
          "role": "MID"
        },
        {
          "dataset": "jma_msm",
          "field": "cloud_cover_low_percent",
          "role": "MID",
          "note": "partial bbox"
        }
      ]
    },
    "cloud_cover_mid": {
      "unit": "%",
      "domain": "WEATHER",
      "bindings": [
        {
          "dataset": "gfs_0p25",
          "field": "cloud_cover_mid_percent",
          "role": "MID"
        },
        {
          "dataset": "jma_msm",
          "field": "cloud_cover_mid_percent",
          "role": "MID",
          "note": "partial bbox"
        }
      ]
    },
    "cloud_cover_mid_and_high": {
      "unit": "%",
      "domain": "WEATHER",
      "kind": "derived",
      "bindings": [
        {
          "dataset": "gfs_0p25",
          "field": "cloud_cover_mid_percent+cloud_cover_high_percent",
          "role": "MID"
        }
      ]
    },
    "cloud_cover_total": {
      "unit": "%",
      "domain": "WEATHER",
      "bindings": [
        {
          "dataset": "gfs_0p25",
          "field": "cloud_cover_total_percent",
          "role": "MID"
        },
        {
          "dataset": "jma_msm",
          "field": "cloud_cover_total_percent",
          "role": "MID",
          "note": "partial bbox"
        }
      ]
    },
    "visibility": {
      "unit": "km",
      "domain": "WEATHER",
      "bindings": [
        {
          "dataset": "gfs_0p25",
          "field": "visibility_km",
          "role": "MID"
        }
      ]
    },
    "aod_550nm": {
      "unit": null,
      "domain": "WEATHER",
      "bindings": [
        {
          "dataset": "cams_global",
          "field": "aerosol_optical_depth_550nm",
          "role": "AEROSOL"
        }
      ]
    },
    "precipitation": {
      "unit": "mm/h",
      "domain": "WEATHER",
      "bindings": [
        {
          "dataset": "gfs_0p25",
          "field": "precipitation_rate_mm_h",
          "role": "MID"
        }
      ]
    },
    "temperature_delta_850_925_c": {
      "unit": "°C",
      "domain": "WEATHER",
      "kind": "derived",
      "bindings": [
        {
          "dataset": "cwa_wrf3",
          "field": "temperature_850hpa_c+temperature_925hpa_c",
          "level": "850hpa,925hpa",
          "role": "SHORT_HQ"
        }
      ]
    },
    "wind_speed_850hpa": {
      "unit": "m/s",
      "domain": "WEATHER",
      "bindings": [
        {
          "dataset": "cwa_wrf3",
          "field": "wind_speed_850hpa_m_s",
          "level": "850hpa",
          "role": "SHORT_HQ"
        }
      ]
    },
    "sunrise_time_window": {
      "unit": null,
      "domain": "ASTRONOMY",
      "kind": "computed",
      "bindings": []
    },
    "sunset_window": {
      "unit": null,
      "domain": "ASTRONOMY",
      "kind": "computed",
      "bindings": []
    },
    "blue_hour_window": {
      "unit": null,
      "domain": "ASTRONOMY",
      "kind": "computed",
      "bindings": []
    },
    "moon_altitude": {
      "unit": "°",
      "domain": "ASTRONOMY",
      "kind": "computed",
      "bindings": []
    },
    "moon_illumination_fraction": {
      "unit": null,
      "domain": "ASTRONOMY",
      "kind": "computed",
      "bindings": []
    },
    "moonrise_moonset_separation_h": {
      "unit": "h",
      "domain": "ASTRONOMY",
      "kind": "computed",
      "bindings": []
    },
    "seasonal_state": {
      "unit": null,
      "domain": "EPHEMERAL",
      "kind": "observation",
      "bindings": []
    },
    "water_surface_state": {
      "unit": null,
      "domain": "EPHEMERAL",
      "kind": "observation",
      "bindings": []
    },
    "wind_speed_10m": {
      "unit": "m/s",
      "domain": "WEATHER",
      "bindings": [
        {
          "dataset": "gfs_0p25",
          "field": "wind_speed_10m_m_s",
          "role": "MID"
        }
      ]
    },
    "astronomical_darkness": {
      "unit": null,
      "domain": "ASTRONOMY",
      "kind": "computed",
      "bindings": [],
      "note_i18n": {
        "zh-TW": "天文暮光：太陽高度 ≤ -18° 的時段窗（座標＋日期計算）",
        "en": "Astronomical darkness: the window when sun elevation is <= -18 deg (from coordinates and date)",
        "ja": "天文的な暗さ：太陽高度≤-18度の時間帯（座標と日付から計算）"
      }
    },
    "galactic_core_altitude": {
      "unit": "°",
      "domain": "ASTRONOMY",
      "kind": "computed",
      "bindings": [],
      "note_i18n": {
        "zh-TW": "銀河核心（人馬座 A 方向）在該座標該時刻的高度角；由 lunar_ephemeris 銀河核心契約計算",
        "en": "Altitude of the galactic core (Sagittarius A direction) at the coordinate and time; from the lunar_ephemeris galactic-core contract",
        "ja": "その座標・時刻における銀河中心（いて座A方向）の高度角。lunar_ephemerisの銀河中心契約による計算"
      }
    },
    "moon_target_separation_deg": {
      "unit": "°",
      "domain": "ASTRONOMY",
      "kind": "computed",
      "bindings": [],
      "note_i18n": {
        "zh-TW": "月亮與目標天體的角分離；對銀河題材目標＝銀河核心，由 lunar_ephemeris 輸出",
        "en": "Angular separation between the moon and the target celestial object; for the Milky-Way scope the target is the galactic core, from lunar_ephemeris",
        "ja": "月と対象天体の角距離。銀河スコープでは対象＝銀河中心。lunar_ephemerisが出力"
      }
    },
    "moon_illuminance_proxy": {
      "unit": null,
      "domain": "ASTRONOMY",
      "kind": "computed",
      "bindings": [],
      "note_i18n": {
        "zh-TW": "月光對天空照度的代理量＝moon_illumination_fraction × sin(moon_altitude)。月照分數忽略月高角（半月天頂 vs 滿月貼地平線差異大），此組合量是物理上更誠實的單一判據；由 lunar_ephemeris 兩項輸出相乘求得",
        "en": "Proxy for moonlight on the sky = moon_illumination_fraction x sin(moon_altitude). The bare illumination fraction ignores moon elevation (half moon at zenith vs full moon at the horizon differ greatly); this product is the more physically honest single measure, computed from the two lunar_ephemeris outputs",
        "ja": "空に対する月光の代理量＝moon_illumination_fraction×sin(moon_altitude)。月照度率だけでは月の高度を無視するため、この積が物理的により誠実な単一指標。lunar_ephemerisの2出力の積で求める"
      }
    }
  },
  "changelog": [
    "0.2 2026-10-26: add wind_speed_10m, astronomical_darkness (draft templates for reflection/milky_way)",
    "0.3 2026-10-26: add galactic_core_altitude, moon_target_separation_deg (night_sky milky-way layer)",
    "0.4 2026-10-26: add moon_illuminance_proxy (night_sky Milky-Way layer moon cap; closes the gibbous-moon gap left when the layer was restructured)"
  ]
}
