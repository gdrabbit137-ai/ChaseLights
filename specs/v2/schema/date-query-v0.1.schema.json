{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gdrabbit137-ai/ChaseLights/blob/main/specs/v2/schema/date-query-v0.1.schema.json",
  "title": "date-query-v0.1.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "query_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "place_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "selected_date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "date_basis": {
      "const": "PLACE_LOCAL_DATE"
    },
    "place_local_date": {
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "time_zone": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "VERIFIED",
            "UNKNOWN"
          ]
        },
        "iana_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "status",
        "iana_id",
        "evidence_ref"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "UNKNOWN"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "iana_id": {
                "type": "null"
              },
              "evidence_ref": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "VERIFIED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "iana_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "evidence_ref": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      ]
    },
    "index_revision": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "state": {
      "enum": [
        "IDLE",
        "LOADING",
        "READY",
        "EMPTY",
        "ERROR",
        "STALE",
        "NOT_EVALUABLE"
      ]
    },
    "reason_code": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "local_day": {
      "anyOf": [
        {
          "$ref": "#/$defs/local_day"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/artifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "recommendation_eligible": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "query_id",
    "generation",
    "place_id",
    "selected_date",
    "date_basis",
    "place_local_date",
    "time_zone",
    "index_revision",
    "state",
    "reason_code",
    "local_day",
    "artifact",
    "recommendation_eligible"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "READY"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "artifact": {
            "$ref": "#/$defs/artifact"
          },
          "local_day": {
            "$ref": "#/$defs/local_day"
          },
          "place_local_date": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "reason_code": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "not": {
              "const": "READY"
            }
          }
        }
      },
      "then": {
        "properties": {
          "artifact": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "time_zone": {
            "properties": {
              "status": {
                "const": "UNKNOWN"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "state": {
            "const": "NOT_EVALUABLE"
          },
          "place_local_date": {
            "type": "null"
          },
          "local_day": {
            "type": "null"
          },
          "reason_code": {
            "const": "UNKNOWN_TIME_ZONE"
          }
        }
      }
    }
  ],
  "$defs": {
    "local_day": {
      "type": "object",
      "properties": {
        "start_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "end_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "start_offset_seconds": {
          "type": "integer",
          "minimum": -86400,
          "maximum": 86400
        },
        "end_offset_seconds": {
          "type": "integer",
          "minimum": -86400,
          "maximum": 86400
        },
        "tzdb_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "start_utc",
        "end_utc",
        "start_offset_seconds",
        "end_offset_seconds",
        "tzdb_version"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "RESEARCH_ONLY",
            "WINDOW",
            "RAW_ONLY",
            "EVALUATION"
          ]
        },
        "artifact_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "data_revision": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "opportunity_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "opportunity_revision": {
          "type": "integer",
          "minimum": 1
        },
        "contract_revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "kind",
        "artifact_ref",
        "artifact_sha256",
        "data_revision",
        "opportunity_id",
        "opportunity_revision",
        "contract_revision"
      ],
      "additionalProperties": false
    }
  }
}
