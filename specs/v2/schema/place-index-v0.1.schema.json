{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gdrabbit137-ai/ChaseLights/blob/main/specs/v2/schema/place-index-v0.1.schema.json",
  "title": "place-index-v0.1.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "index_revision": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "region_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "country_code": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "level": {
            "enum": [
              "COUNTRY",
              "ADMIN1"
            ]
          },
          "name_i18n": {
            "type": "object",
            "properties": {
              "zh-TW": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "en": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "ja": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "zh-TW",
              "en",
              "ja"
            ],
            "additionalProperties": false
          },
          "code_standard": {
            "enum": [
              "ISO_3166_1",
              "ISO_3166_2"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "region_id",
          "country_code",
          "level",
          "name_i18n",
          "code_standard",
          "code"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "places": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "place_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "name_i18n": {
            "type": "object",
            "properties": {
              "zh-TW": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "pattern": "\\S"
              },
              "en": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "pattern": "\\S"
              },
              "ja": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "zh-TW",
              "en",
              "ja"
            ],
            "additionalProperties": false
          },
          "aliases_i18n": {
            "type": "object",
            "properties": {
              "zh-TW": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "en": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "ja": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 0,
                "uniqueItems": true
              }
            },
            "required": [
              "zh-TW",
              "en",
              "ja"
            ],
            "additionalProperties": false
          },
          "metadata_status": {
            "enum": [
              "COMPLETE",
              "PARTIAL",
              "UNKNOWN"
            ]
          },
          "semantic_review": {
            "enum": [
              "PENDING",
              "APPROVED"
            ]
          },
          "country_codes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "region_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "admin_status": {
            "enum": [
              "COMPLETE",
              "PARTIAL",
              "UNKNOWN"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "time_zone": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "VERIFIED",
                  "UNKNOWN"
                ]
              },
              "iana_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "pattern": "\\S"
              },
              "evidence_ref": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "status",
              "iana_id",
              "evidence_ref"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "UNKNOWN"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "iana_id": {
                      "type": "null"
                    },
                    "evidence_ref": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "VERIFIED"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "iana_id": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "evidence_ref": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  }
                }
              }
            ]
          }
        },
        "required": [
          "place_id",
          "name_i18n",
          "aliases_i18n",
          "metadata_status",
          "semantic_review",
          "country_codes",
          "region_ids",
          "admin_status",
          "evidence_refs",
          "time_zone"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "metadata_status": {
                  "const": "COMPLETE"
                }
              },
              "required": [
                "metadata_status"
              ]
            },
            "then": {
              "properties": {
                "name_i18n": {
                  "type": "object",
                  "properties": {
                    "zh-TW": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "en": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "ja": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  },
                  "required": [
                    "zh-TW",
                    "en",
                    "ja"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "admin_status": {
                  "const": "UNKNOWN"
                }
              },
              "required": [
                "admin_status"
              ]
            },
            "then": {
              "properties": {
                "country_codes": {
                  "maxItems": 0
                },
                "region_ids": {
                  "maxItems": 0
                }
              }
            }
          }
        ]
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "opportunity_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "place_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "source_commit_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "source_path": {
            "type": "string",
            "pattern": "^data/v2/opportunities/[^/]+\\.json$"
          },
          "source_blob_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "publication": {
            "enum": [
              "RESEARCH_ONLY",
              "GUIDE_ELIGIBLE",
              "WITHHELD"
            ]
          },
          "publication_reason_codes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "publication_approval_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "opportunity_id",
          "place_id",
          "revision",
          "source_commit_sha",
          "source_path",
          "source_blob_sha",
          "publication",
          "publication_reason_codes",
          "publication_approval_ref"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "publication": {
                  "const": "GUIDE_ELIGIBLE"
                }
              },
              "required": [
                "publication"
              ]
            },
            "then": {
              "properties": {
                "publication_approval_ref": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "publication": {
                  "not": {
                    "const": "GUIDE_ELIGIBLE"
                  }
                }
              }
            },
            "then": {
              "properties": {
                "publication_approval_ref": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "index_revision",
    "regions",
    "places",
    "opportunities"
  ],
  "additionalProperties": false
}
