{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gdrabbit137-ai/ChaseLights/blob/main/specs/v2/schema/opportunity-v2.1.schema.json",
  "title": "ChaseLights V2.1 Photography Opportunity Contract",
  "description": "Canonical Opportunity document. Structural checks only; geographic, evidence, semantic-parity and recommendation gates require separate review/CI.",
  "type": "object",
  "required": [
    "schema_version",
    "opportunity_id",
    "place_id",
    "revision",
    "lifecycle_status",
    "name_i18n",
    "camera_contexts",
    "targets",
    "observation_relations",
    "navigation_targets",
    "condition_contract",
    "evidence_claims",
    "readiness",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "2.1.0"
    },
    "opportunity_id": {
      "type": "string",
      "minLength": 1
    },
    "place_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "lifecycle_status": {
      "enum": [
        "draft",
        "evidence_review",
        "approved",
        "retired"
      ]
    },
    "name_i18n": {
      "$ref": "#/$defs/i18n"
    },
    "description_i18n": {
      "$ref": "#/$defs/i18n"
    },
    "camera_contexts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/camera"
      },
      "minItems": 1
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/target"
      },
      "minItems": 1
    },
    "observation_relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "navigation_targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/navigation"
      }
    },
    "condition_contract": {
      "type": "object",
      "required": [
        "contract_id",
        "status",
        "conditions"
      ],
      "properties": {
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "draft",
            "review",
            "approved"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "recommendation_policy_version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "evidence_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "claim_type",
          "evidence_refs",
          "audit_status"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "claim_type": {
            "enum": [
              "existence",
              "seasonality",
              "formation",
              "forecastability",
              "calibration",
              "camera_location",
              "target_geometry",
              "navigation_access",
              "condition_threshold",
              "other"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "audit_status": {
            "enum": [
              "OK",
              "PARTIAL",
              "MISMATCH",
              "UNKNOWN"
            ]
          },
          "scope_note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "readiness": {
      "type": "object",
      "required": [
        "research_level",
        "runtime_availability",
        "gaps"
      ],
      "properties": {
        "research_level": {
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3"
          ]
        },
        "runtime_availability": {
          "enum": [
            "FULL",
            "LIMITED",
            "GUIDANCE_ONLY",
            "UNAVAILABLE",
            "NOT_EVALUATED"
          ]
        },
        "gaps": {
          "type": "array",
          "items": {
            "enum": [
              "RESEARCH_GAP",
              "GEOMETRY_GAP",
              "DATA_UNAVAILABLE",
              "MODEL_UNSUPPORTED",
              "DYNAMIC_UNVERIFIED",
              "SOURCE_CONFLICT",
              "LOW_CONFIDENCE",
              "STALE_DATA"
            ]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_catalog",
        "imported_at",
        "review_status"
      ],
      "properties": {
        "source_catalog": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "imported_at": {
          "type": "string",
          "format": "date-time"
        },
        "review_status": {
          "enum": [
            "pending",
            "reviewed",
            "approved"
          ]
        },
        "reviewed_by": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "i18n": {
      "type": "object",
      "required": [
        "zh-TW",
        "en",
        "ja"
      ],
      "properties": {
        "zh-TW": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        },
        "ja": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "geometry": {
      "type": "object",
      "required": [
        "kind",
        "status"
      ],
      "properties": {
        "kind": {
          "enum": [
            "point",
            "polygon",
            "polyline",
            "ridge",
            "area",
            "horizon_sector",
            "foreground_area",
            "water_surface",
            "dynamic_sky",
            "atmospheric_volume",
            "none"
          ]
        },
        "status": {
          "enum": [
            "verified",
            "provisional",
            "derived",
            "unknown",
            "not_applicable"
          ]
        },
        "geojson": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "type",
                "coordinates"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "Point",
                    "MultiPoint",
                    "LineString",
                    "MultiLineString",
                    "Polygon",
                    "MultiPolygon"
                  ]
                },
                "coordinates": {
                  "type": "array",
                  "minItems": 1
                }
              },
              "additionalProperties": false,
              "description": "GeoJSON coordinates in WGS84 lon/lat order; topology and range validated by geographic audit."
            },
            {
              "type": "null"
            }
          ]
        },
        "uncertainty_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "derivation_method": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_geometry_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason_if_absent": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_applicable"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "geojson": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "camera": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "geometry",
        "verification_status",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "point",
            "area",
            "route",
            "mobile_platform"
          ]
        },
        "geometry": {
          "$ref": "#/$defs/geometry"
        },
        "verification_status": {
          "enum": [
            "verified",
            "representative",
            "provisional",
            "unknown"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "access_notes_i18n": {
          "$ref": "#/$defs/i18n"
        },
        "safety_notes_i18n": {
          "$ref": "#/$defs/i18n"
        },
        "altitude_m": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name_i18n",
        "geometry",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "fixed_geographic",
            "celestial_target",
            "dynamic_sky",
            "atmospheric_volume",
            "observer_dependent_phenomenon",
            "environmental_state",
            "multi_component"
          ]
        },
        "name_i18n": {
          "$ref": "#/$defs/i18n"
        },
        "geometry": {
          "$ref": "#/$defs/geometry"
        },
        "phenomenon_model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": [
        "id",
        "camera_context_id",
        "target_id",
        "type",
        "geometry_mode",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "camera_context_id": {
          "type": "string",
          "minLength": 1
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "line_of_sight",
            "sky_visibility",
            "reflection",
            "alignment",
            "occlusion",
            "foreground_background",
            "terrain_cloud",
            "observer_dependent",
            "temporal_relation",
            "interaction"
          ]
        },
        "geometry_mode": {
          "enum": [
            "static_verified",
            "static_derived",
            "runtime_dynamic",
            "unknown"
          ]
        },
        "azimuth_deg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "elevation_deg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "distance_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "derivation_method": {
          "type": [
            "string",
            "null"
          ]
        },
        "uncertainty_note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "navigation": {
      "type": "object",
      "required": [
        "id",
        "status",
        "target_type",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "verified",
            "provisional_camera_anchor",
            "needs_review",
            "multiple_access_routes"
          ]
        },
        "target_type": {
          "enum": [
            "entrance",
            "trailhead",
            "parking",
            "station",
            "street_access",
            "viewpoint",
            "camera_zone_or_place_anchor",
            "other"
          ]
        },
        "lat": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        },
        "label_i18n": {
          "$ref": "#/$defs/i18n"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "verified"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "lat",
              "lon"
            ],
            "properties": {
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lon": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "required": [
        "id",
        "role",
        "domain",
        "evaluation_mode",
        "capability",
        "metric",
        "unknown_policy",
        "claim_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "REQUIRED",
            "BLOCKER",
            "QUALITY"
          ]
        },
        "domain": {
          "enum": [
            "WEATHER",
            "ASTRONOMY",
            "SEASON_TIME",
            "ACCESS_SAFETY",
            "SUBJECT_STATE",
            "GEOMETRY_COMPOSITION",
            "SPACE_WEATHER",
            "OCEAN",
            "HYDROLOGY"
          ]
        },
        "evaluation_mode": {
          "enum": [
            "AUTO",
            "GUIDANCE",
            "VERIFY"
          ]
        },
        "capability": {
          "enum": [
            "WINDOW",
            "CONDITIONS",
            "PROBABILITY",
            "OBSERVATION"
          ]
        },
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "enum": [
            "gt",
            "gte",
            "lt",
            "lte",
            "eq",
            "neq",
            "between",
            "in",
            "not_in",
            "is_true",
            "is_false",
            "none"
          ]
        },
        "threshold": {
          "type": [
            "number",
            "string",
            "boolean",
            "array",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "unknown_policy": {
          "const": "propagate_unknown"
        },
        "claim_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "model_binding": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes_i18n": {
          "$ref": "#/$defs/i18n"
        },
        "validation_status": {
          "enum": [
            "unvalidated",
            "provisional",
            "validated"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
