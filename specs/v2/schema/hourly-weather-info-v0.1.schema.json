      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "const": "mm"
        },
        "source_unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "enum": [
            "AVAILABLE",
            "UNAVAILABLE"
          ]
        },
        "reason_code": {
          "enum": [
            null,
            "MISSING_FIELD",
