        "source_unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "enum": [
            "AVAILABLE",
            "UNAVAILABLE"
          ]
        },
        "reason_code": {
          "enum": [
            null,
            "MISSING_FIELD",
            "NULL_VALUE",
            "INVALID_VALUE",
            "UNIT_MISMATCH"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "AVAILABLE"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0
              },
              "source_unit": {
                "const": "m"
              },
              "reason_code": {
                "const": null
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "const": null
              },
              "reason_code": {
                "enum": [
                  "MISSING_FIELD",
