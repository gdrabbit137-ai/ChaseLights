              "source_unit": {
                "const": "m/s"
              },
              "reason_code": {
                "const": null
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "const": null
              },
              "reason_code": {
                "enum": [
                  "MISSING_FIELD",
                  "NULL_VALUE",
                  "INVALID_VALUE",
                  "UNIT_MISMATCH"
                ]
              }
            }
          }
        }
      ]
    },
    "distance": {
      "type": "object",
      "required": [
        "value",
        "unit",
        "source_unit",
        "state",
        "reason_code"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
