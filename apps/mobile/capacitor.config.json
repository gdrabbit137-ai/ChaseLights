{
  "appId": "com.chaselights.app",
  "appName": "ChaseLights",
  "type": "module",
  "webDir": "www",
  "android": {
    "allowMixedContent": false
  },
  "server": {
    "androidScheme": "https",
    "url": "https://chaselights.app",
    "cleartext": false
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["alert", "badge", "sound"]
    },
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#0b0f14"
    }
  }
}
