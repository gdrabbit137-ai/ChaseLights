{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://chaselights.app",
          "https://chaselights.pages.dev"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["*"]
      },
      "exposeHeaders": ["ETag", "Content-Length", "Content-Type"],
      "maxAgeSeconds": 86400
    }
  ]
}
